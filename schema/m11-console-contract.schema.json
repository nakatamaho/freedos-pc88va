{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M11 console input contract",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "mechanism", "abi", "boundaries", "controls", "excluded"],
  "properties": {
    "schema_version": {"const": 1}, "status": {"enum": ["qualified", "in_progress"]},
    "mechanism": {"const": "read-only PC-88VA keyboard matrix polling"},
    "abi": {"type": "object", "additionalProperties": false, "required": ["argument", "result", "success", "no_input", "unsupported", "invalid", "preserved", "preconditions"], "properties": {"argument": {"const": "AX points to exported M11 character word"}, "result": {"const": "AX status; character word owned by service"}, "success": {"const": 0}, "no_input": {"const": 1}, "unsupported": {"const": 2}, "invalid": {"const": 65535}, "preserved": {"const": ["BX", "CX", "DX", "SI", "DI", "BP", "DS", "ES", "SS", "SP", "FLAGS"]}, "preconditions": {"const": ["DS=CS", "M10 ready", "IF=DF=TF=0"]}}},
    "boundaries": {"const": ["K0", "K1", "K2", "K3", "K4", "K5", "K6", "K7", "K8", "K9"]},
    "controls": {"const": ["N0", "N1", "N2", "N3", "N4"]},
    "excluded": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
