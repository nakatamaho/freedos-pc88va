@ECHO OFF
SET M15VALUE=outer
ECHO one>FLOW.TXT
CALL INNER.BAT alpha beta
ECHO %M15VALUE%>>FLOW.TXT
FOR %%v IN (A B C) DO ECHO %%v>>FLOW.TXT
EXITQA 7
IF ERRORLEVEL 8 GOTO BAD
IF NOT ERRORLEVEL 7 GOTO BAD
ECHO status-seven>>FLOW.TXT
IF EXIST MISSING.QA GOTO BAD
IF NOT EXIST FLOW.TXT GOTO BAD
COPY /B TYPEA.TXT SHELLA.TXT >COPY.OUT
REN SHELLA.TXT SHELLB.TXT
TYPE SHELLB.TXT >TYPE.OUT
MD WORKQA
COPY /B TYPEB.TXT WORKQA\NEST.TXT >NEST.OUT
CD WORKQA
TYPE NEST.TXT >SEEN.TXT
CD ..
COPY /B WORKQA\SEEN.TXT SEEN.OUT >NEST.OUT
DEL WORKQA\NEST.TXT
DEL WORKQA\SEEN.TXT
RD WORKQA
MD TMPQA
SET TEMP=A:\TMPQA
ECHO alpha Beta>LOWER.TXT
STREAM <LOWER.TXT >UPPER.TXT
IF ERRORLEVEL 1 GOTO BAD
TYPE LOWER.TXT | STREAM >PIPE.TXT
IF ERRORLEVEL 1 GOTO BAD
ECHO tail>>PIPE.TXT
TYPE PIPE.TXT >NUL
ECHO parent-restored>AFTER.TXT
COPY /B STREAM.COM TMPQA\FILTER.COM >LOOKUP.OUT
SET PATH=A:\TMPQA
FILTER <LOWER.TXT >LOOKUP.TXT
IF ERRORLEVEL 1 GOTO BAD
SET PATH=
DEL TMPQA\FILTER.COM
SET TEMP=
RD TMPQA
SET M15VALUE=
DEL SHELLB.TXT
ECHO complete>SHELL.OK
GOTO DONE
:BAD
ECHO failure>SHELL.BAD
:DONE
ECHO M15 shell batch returned
